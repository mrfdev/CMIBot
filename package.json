{
  "name": "cmibot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Channel-aware Discord lookup bot for Zrips plugin support data.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "remote": "node scripts/cmibot-remote.mjs",
    "remote:status": "node scripts/cmibot-remote.mjs status",
    "remote:restart": "node scripts/cmibot-remote.mjs restart",
    "remote:deploy": "node scripts/cmibot-remote.mjs deploy",
    "remote:logs": "node scripts/cmibot-remote.mjs logs",
    "test": "node --test",
    "lookup": "node src/cli.js",
    "build:exporter": "node scripts/build-runtime-exporter.mjs",
    "refresh:data": "node scripts/refresh-clean-server.mjs",
    "refresh:indexes": "node scripts/plugin-jar-indexes.mjs",
    "refresh:versions": "node scripts/refresh-versions.mjs",
    "smoke:java25": "node scripts/smoke-paper-runtime.mjs --expect 25 --label java25",
    "smoke:java26": "node scripts/smoke-paper-runtime.mjs --expect 26 --label java26",
    "check:paper": "node scripts/verify-paper-compatibility.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=moderate",
    "outdated:deps": "npm outdated --depth=0",
    "update:check": "node scripts/safe-update.mjs --check",
    "update:safe": "node scripts/safe-update.mjs",
    "check:syntax": "for file in src/*.js src/discord/*.js scripts/*.mjs; do node --check \"$file\" || exit 1; done",
    "check:bot": "npm run check:syntax && node --test",
    "check": "npm run check:bot && node scripts/verify-paper-compatibility.mjs --offline"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.20.0",
    "dotenv": "^16.6.1",
    "fast-glob": "^3.3.3",
    "openai": "^6.49.0"
  }
}
